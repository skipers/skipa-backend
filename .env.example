RABBITMQ_PORT=5672
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=

AI_SERVER_BASE_URL=http://localhost:8000
AI_PRE_EVALUATION_CHAT_PATH=/pre-evaluations/chat

REPORT_EXCHANGE=skipa.report.exchange
