JWT_SECRET=
INTERNAL_API_KEY=

# Spring profile: local or prod
SPRING_PROFILES_ACTIVE=local

# Optional local sample account password override
LOCAL_SEED_PASSWORD=1234

DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# Required outside the local profile for AI report generation.
RABBITMQ_HOST=
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=

AI_SERVER_BASE_URL=http://localhost:8000
AI_REPORT_CHAT_PATH=/api/v1/patents/{patent_id}/chat
AI_PRE_EVALUATION_CHAT_PATH=/api/v1/pre-eval/cases/{case_id}/chat
AI_PORTFOLIO_INSIGHTS_PATH=/portfolio/insights
AI_PORTFOLIO_INSIGHTS_CONNECT_TIMEOUT_MS=3000
AI_PORTFOLIO_INSIGHTS_READ_TIMEOUT_MS=30000
PORTFOLIO_INSIGHTS_CACHE_TTL_SECONDS=86400

RABBITMQ_EXCHANGE=skipa.exchange

REPORT_GENERATE_QUEUE=skipa.report.generate
REPORT_GENERATE_ROUTING_KEY=report.generate

PATENT_EXTRACT_QUEUE=skipa.patent-extract
PATENT_EXTRACT_ROUTING_KEY=patent.extract

PRE_EVALUATION_GENERATE_QUEUE=skipa.pre-evaluation.generate
PRE_EVALUATION_GENERATE_ROUTING_KEY=pre-evaluation.generate

# Required outside the local profile for report downloads and patent PDF extraction uploads.
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT=https://minio-team8-skipa.skala25a.project.skala-ai.com
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=skipa
MINIO_REGION=us-east-1
MINIO_PRESIGNED_URL_EXPIRY_SECONDS=600
